# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=picking_webapp
DB_USER=postgres
DB_PASSWORD=your_password

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# WooCommerce API (à remplir plus tard)
WC_URL=https://your-store.com
WC_CONSUMER_KEY=your_consumer_key
WC_CONSUMER_SECRET=your_consumer_secret

# Statut poussé sur WooCommerce quand une commande est validée dans l'app.
# « completed » doit rester réservé aux commandes reçues par le client : renseigner
# ici le slug du statut intermédiaire déclaré dans WooCommerce (ex: pret-expedition).
# Non renseigné = completed (comportement historique).
WC_STATUS_ON_COMPLETE=

# CORS Configuration
FRONTEND_URL=http://localhost:5173
